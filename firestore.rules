rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profiles: readable by any signed-in user (so friends/circles can look up display names),
    // writable only by the owner — except for the `friendIds` array, which
    // either party needs to patch when a friendship is accepted or removed.
    // Restricting the diff to that single field keeps the rest of the
    // profile owner-only.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId)
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds']));
      allow delete: if false;

      // Personal prayer book: snapshots of prayers the owner is praying
      // for. Only the owner can read or write their own book.
      match /prayerBook/{prayerId} {
        allow read, write: if isSelf(userId);
      }

      // Per-user private settings (e.g. the prayer book canvas layout).
      // Owner-only so nobody else can see how someone has arranged their
      // prayers.
      match /settings/{settingId} {
        allow read, write: if isSelf(userId);
      }

      // Personal notifications. Any signed-in user can create a
      // notification for another user (e.g. "your circle was deleted"),
      // but only the recipient can read, update, or delete them.
      match /notifications/{notifId} {
        allow read: if isSelf(userId);
        allow create: if isSignedIn();
        allow update, delete: if isSelf(userId);
      }
    }

    // Username reservations. Doc id is the lowercased username. A user may
    // only reserve a username they own. Delete is allowed by the owner so
    // they can release their old username when they change it.
    //
    // `get` is public (unsigned-in) so the signup form can check whether a
    // username is already taken before it creates a Firebase Auth user —
    // otherwise we'd orphan accounts on every collision. `list` stays
    // gated so nobody can enumerate every username.
    match /usernames/{usernameLower} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Friend requests / friendships. A friendship doc id is the sorted pair "uidA_uidB".
    // Either party can read or delete. Create requires the requester to be one of the pair.
    //
    // The read rule also permits fetching non-existent docs so the "do we
    // already have a friendship/request with this user?" pre-check on
    // sendRequest doesn't fail on a null `resource`.
    match /friendships/{friendshipId} {
      allow read: if isSignedIn()
                  && (resource == null || request.auth.uid in resource.data.users);
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2;
      allow update: if isSignedIn() && request.auth.uid in resource.data.users;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // Circle invite links. Anyone signed in can read (to accept) or create
    // (invitedBy must be themself). Only the creator can delete.
    match /circleInvites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.invitedBy == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.invitedBy == request.auth.uid;
      allow update: if false;
    }

    // Prayer circles: readable by members, creatable by anyone signed in, updatable by creator or members
    // (to add themselves). Members array controls access.
    match /circles/{circleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.members;
      // Allow any signed-in user to join/leave by editing members; creator can edit any field.
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Prayers: visibility is enforced at read time.
    // - public: anyone signed in can read
    // - friend: only author or the target friend
    // - circles: only author or members of any of the listed circles
    match /prayers/{prayerId} {
      allow read: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.authorId == request.auth.uid ||
        (resource.data.visibility == 'friend' && resource.data.targetUserId == request.auth.uid) ||
        (resource.data.visibility == 'circles' && resource.data.circleIds.hasAny(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.circleIds
        ))
      );
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        // anyone with read access can increment prayedBy/count
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayedBy', 'prayedCount'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
